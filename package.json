{
  "name": "next-better-auth-starter",
  "version": "1.0.0",
  "description": "A modern Next.js boilerplate with authentication, admin dashboard, and user management built with Better Auth, Drizzle ORM, and PostgreSQL",
  "private": true,
  "author": "Cinaq",
  "license": "MIT",
  "homepage": "https://cinaq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cinaq/low-ops-nextjs-starter"
  },
  "scripts": {
    "dev": "next dev --turbopack -p ${PORT:-8000}",
    "build": "next build",
    "start": "next start -p ${PORT:-8000}",
    "lint": "eslint .",
    "db:create": "docker compose up -d postgres minio minio-init",
    "compose:up": "docker compose --profile app up -d --build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@hookform/resolvers": "^5.7.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.18.1",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tsx": "^4.23.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "postcss": "$postcss"
  }
}
